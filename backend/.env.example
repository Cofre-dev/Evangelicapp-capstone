# Dev local: un Postgres descartable (docker-compose.yml de este dir, o cualquiera).
# Producción corre contra el proyecto Supabase `Backend-staging` conectando como el rol
# `app_runtime` (sin BYPASSRLS) — esa URL vive en Render, no acá. Ver README "Migraciones
# de base de datos" para el flujo (local → branch de Supabase para RLS → prod por MCP).
DATABASE_URL="postgresql://user:password@localhost:5432/evangelicapp"
PORT=3001
# Uno o varios orígenes separados por coma (sin espacios extra al final). Requerido:
# las cookies de auth exigen credentials:true en el fetch, lo que prohíbe origin:"*".
CORS_ORIGIN="http://localhost:3000"

# En "production" las cookies de auth se marcan Secure (solo viajan por HTTPS).
NODE_ENV="development"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

FRONTEND_URL="http://localhost:3000"
# Usado para construir URLs absolutas dentro de correos (ej. el logo de la iglesia
# en la convocatoria de eventos) — un <img> en un email no puede usar una ruta relativa.
BACKEND_URL="http://localhost:3001"
SMTP_HOST="localhost"
SMTP_PORT=1025
# Remitente de TODOS los correos. Con MAIL_PROVIDER=resend tiene que ser una
# dirección del dominio verificado en Resend (evangelicapp.cl ya está verificado):
#   MAIL_FROM="EvangelicApp <no-reply@evangelicapp.cl>"
MAIL_FROM="EvangelicApp <no-reply@evangelicapp.cl>"

# 'smtp' (default local, usa SMTP_HOST/SMTP_PORT vía Nodemailer) o 'resend'.
# En staging/prod: "resend".
MAIL_PROVIDER="smtp"
# Requerido con MAIL_PROVIDER=resend. Formato re_xxx (Resend > API Keys). El dominio
# evangelicapp.cl ya está verificado, así que MAIL_FROM puede usar @evangelicapp.cl
# y el envío masivo a la congregación funciona (ya no aplica el límite de sandbox
# de onboarding@resend.dev).
RESEND_API_KEY=""

# Supabase Storage (logos de iglesia, fotos de perfil, fotos de integrantes).
# SUPABASE_URL es la URL del proyecto (no secreta). SUPABASE_SERVICE_ROLE_KEY es
# secreta: se saca del dashboard de Supabase (Project Settings > API > service_role),
# nunca del cliente/frontend — el backend la usa para subir/borrar objetos sin
# depender de RLS (los 3 buckets son públicos solo para lectura).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Realtime — migración de socket.io a Supabase Broadcast (ver
# docs/realtime-migration.md). Todas apuntan al MISMO proyecto que SUPABASE_URL
# (donde corren la BD y Realtime), no al proyecto de Auth.
#
# SUPABASE_JWT_ACCESS_SECRET: "JWT Secret" del proyecto (Dashboard > Project
# Settings > API > JWT Settings, o "Legacy JWT secret" si el proyecto ya migró a
# signing keys asimétricas). El backend firma con él (HS256) los tokens de corta
# duración que sirve en GET /realtime/token para que el navegador autentique su
# WebSocket a Realtime. Sin esta variable, GET /realtime/token responde 503 y el
# frontend cae a socket.io mientras dure el parallel-run.
SUPABASE_JWT_ACCESS_SECRET=""
# Validez del token de Realtime en segundos (default 1800 = 30 min). El frontend
# re-pide uno nuevo antes de que expire.
REALTIME_TOKEN_TTL_SECONDS="1800"
# "false" apaga el emit por Supabase Broadcast (deja solo socket.io) sin redeploy
# de código — escotilla para el parallel-run. Default: encendido.
REALTIME_BROADCAST_ENABLED="true"

# Fase 7 (docs/supabase.md) — Supabase Auth. Desde el "cutover final" (commit 21a01f83)
# YA NO SON OPCIONALES: AuthService#validateUser exige una sesión válida de
# signInWithPassword para CUALQUIER login (bcrypt local solo decide si hay que
# sincronizar la contraseña hacia Supabase Auth, no reemplaza esa sesión) — sin estas
# 3 variables, todo login responde 401 "Credenciales inválidas" aunque la contraseña
# sea correcta (encontrado corriendo el backend en un entorno de staging real sin
# configurarlas, 2026-08-25). Pueden apuntar a un proyecto Supabase separado y
# descartable dedicado solo a Auth ("Backend-auth-test") o al mismo proyecto que ya
# usás para DATABASE_URL/Storage — cualquier proyecto Supabase trae Auth incluido,
# no hace falta uno dedicado. service_role/anon key se sacan del dashboard de
# CUALQUIERA sea el proyecto elegido (Project Settings > API).
SUPABASE_AUTH_TEST_URL="https://grcywqjcqwpbuekqbupj.supabase.co"
SUPABASE_AUTH_TEST_SERVICE_ROLE_KEY=""
# anon key (legacy, formato JWT) del mismo proyecto de prueba — la usa
# SupabaseAuthService#signInWithPassword/refreshSession como header `apikey`
# contra /auth/v1/token, igual que exige la API REST de GoTrue.
SUPABASE_AUTH_TEST_ANON_KEY=""

# WhatsApp Business Cloud API (Meta) — convocatoria a integrantes, siempre junto al email
# de MailService, nunca en su reemplazo. Opcional: sin WHATSAPP_ACCESS_TOKEN, WhatsAppModule
# usa un provider no-op (log de warning una sola vez) y el email sigue siendo el único canal
# real — nadie necesita credenciales de Meta para correr el backend local. Se sacan desde
# developers.facebook.com > tu app > WhatsApp > API Setup (token temporal de prueba) o desde
# WhatsApp Manager (token permanente de producción, junto con la verificación de negocio).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Nombre de la plantilla aprobada en WhatsApp Manager > Message Templates (categoría Utility).
WHATSAPP_TEMPLATE_CONVOCATORIA_EVENTO="convocatoria_evento"
