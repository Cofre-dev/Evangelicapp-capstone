# URL base del backend (NestJS).
#   Local:      http://localhost:3001  (valor por defecto abajo)
#   Producción: https://api.evangelicapp.cl  -- se setea en el panel de build del
#               hosting (Cloudflare Workers), no en este archivo.
#   Ver frontend/docs/deploy-produccion.md.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Realtime — SOLO para el canal de tiempo real de las pantallas
# "en vivo" (dashboard SuperAdmin, detalle de evento/convocatoria, censo QR).
# Ver src/hooks/use-realtime.ts. NO se usa supabase-js para datos/auth/storage:
# eso sigue yendo por apiFetch contra el backend.
# La anon key NO es secreta (es publishable); sacala del dashboard del proyecto
# Supabase (Project Settings > API > anon/public) o pedila al equipo. Si faltan,
# el frontend arranca en modo "sin realtime" (las pantallas siguen con su carga
# REST normal).
# El proyecto de producción es "evangelicapp-prod" (woerftoeqarupnrggupl).
# next.config.ts deriva el hostname de Storage de esta variable.
NEXT_PUBLIC_SUPABASE_URL=https://woerftoeqarupnrggupl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API key de biblia.com (Faithlife/Logos) para el "Versículo del día" del
# dashboard de Manager/Usuario. Ver src/components/dashboard/versiculo-del-dia.tsx.
# Es una key de tipo "Web" atada al dominio (Application URL = https://app.evangelicapp.cl):
# no es secreta, misma categoría que la anon key de Supabase, pero no se commitea.
# Sacala de https://app.biblia.com/api-keys (o pedila al equipo). Si falta, la
# card del versículo no se muestra y el dashboard funciona igual.
NEXT_PUBLIC_BIBLIA_API_KEY=

# URL de la política de privacidad (Ley 21.719) que se linkea en el checkbox
# de consentimiento del formulario público de registro de integrantes. Si no
# se define, cae a la ruta relativa /politica-privacidad (esa página ya existe).
#NEXT_PUBLIC_URL_POLITICA_PRIVACIDAD=/politica-privacidad

# Deploy a Cloudflare Workers (ver wrangler.jsonc): desactiva la optimización
# on-the-fly de next/image, que en Cloudflare requiere Cloudflare Images o un
# loader custom. Se setea en el panel de build del Worker, no en local.
# Con los logos/fotos ya servidos como URL pública HTTPS, la salida simple es
# dejar next/image como <img> plano en ese entorno.
#NEXT_IMAGES_UNOPTIMIZED=true